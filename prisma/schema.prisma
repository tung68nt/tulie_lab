generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Schema Version: 2 (Force Rebuild)

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  password      String
  role          Role               @default(USER)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  boughtCodes   ActivationCode[]   @relation("BoughtCodes")
  redeemedCodes ActivationCode[]   @relation("RedeemedCodes")
  activityLogs  ActivityLog[]
  enrollments   Enrollment[]
  progress      LessonProgress[]
  marketingLead MarketingLead[]
  orders        Order[]
  securityLogs  SecurityLog[]
  subscriptions Subscription[]
  notifications   UserNotification[]
  profile         UserProfile?
  sessions        UserSession[]
  invoiceProfiles UserInvoiceProfile[]
  notes           UserNote[]

  @@index([role])
  @@index([email])
  @@index([role, isActive])
}

model UserProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  name                String?
  phone               String?
  birthDate           DateTime?
  address             String?
  city                String?
  occupation          String?
  company             String?
  avatar              String?
  allowEmailMarketing Boolean   @default(true)
  allowSMSMarketing   Boolean   @default(false)
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  isValid      Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("text")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemNotification {
  id             String             @id @default(uuid())
  title          String
  content        String
  type           NotificationType   @default(SYSTEM)
  isActive       Boolean            @default(true)
  startDate      DateTime?
  endDate        DateTime?
  targetAll      Boolean            @default(true)
  targetBirthday Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  recipients     UserNotification[]
}

model UserNotification {
  id               String   @id @default(uuid())
  userId           String
  notificationId   String
  isRead           Boolean  @default(false)
  readAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification     SystemNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
  @@index([isRead])
}

model SecurityLog {
  id        String         @id @default(uuid())
  userId    String?
  action    SecurityAction
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  path      String?
  ipAddress String?
  location  String?
  device    String?
  metadata  String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  type      String
  status    String   @default("sent")
  userId    String?
  orderId   String?
  metadata  String?
  error     String?
  createdAt DateTime @default(now())
}

model MarketingLead {
  id        String   @id @default(uuid())
  userId    String?
  orderId   String   @unique
  source    String?
  medium    String?
  campaign  String?
  term      String?
  content   String?
  fbc       String?
  gclid     String?
  clickId   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
  blogPosts   BlogPost[]
}

model Course {
  id                String                 @id @default(uuid())
  title             String
  slug              String                 @unique
  description       String?
  thumbnail         String?
  price             Decimal                @default(0) @db.Decimal(12, 0)
  compareAtPrice    Decimal?               @db.Decimal(12, 0)
  isPublished       Boolean                @default(false)
  deploymentStatus  String
  tag               CourseTag              @default(NONE)
  introVideoUrl     String?
  learningOutcomes  String?                @db.Text
  structure         String?                @db.Text
  // Countdown/Campaign fields
  campaignId        String?
  saleStartDate     DateTime?
  saleEndDate       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  instructorId      String?
  categoryId        String?
  activationCodes   ActivationCode[]
  bundles           BundleCourse[]
  category          Category?              @relation(fields: [categoryId], references: [id])
  instructor        Instructor?            @relation(fields: [instructorId], references: [id])
  campaign          Campaign?              @relation(fields: [campaignId], references: [id])
  registrations     CourseRegistration[]
  enrollments       Enrollment[]
  landingPages      LandingPage[]          @relation("LandingPageCourse")
  upsellForPages    LandingPage[]          @relation("LandingPageUpsell")
  lessons           Lesson[]
  orderItems        OrderItem[]
  // Upsell relations
  upsellCourses     CourseUpsell[]         @relation("CourseToUpsellCourses")
  upsellFor         CourseUpsell[]         @relation("UpsellCourseToCourse")
  upsellProducts    CourseProductUpsell[]  @relation("CourseToUpsellProducts")
  upsellFromProduct ProductCourseUpsell[]  @relation("ProductUpsellCourse")

  @@index([isPublished])
  @@index([price])
}

model Lesson {
  id          String           @id @default(uuid())
  title       String
  slug        String
  description String?
  thumbnail   String?
  videoUrl    String?
  duration    String?
  chapter     String?
  section     String?
  content     String?
  isFree      Boolean          @default(false)
  position    Int              @default(0)
  courseId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  attachments Attachment[]
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]

  @@unique([courseId, slug])
  @@index([courseId])
}

model Attachment {
  id        String   @id @default(uuid())
  name      String
  url       String
  type      String   @default("FILE")
  lessonId  String
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Instructor {
  id           String     @id @default(uuid())
  name         String
  title        String?
  bio          String?
  avatar       String?
  socialLinks  String?
  studentCount Int        @default(0)
  courseCount  Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  blogPosts    BlogPost[]
  courses      Course[]
}

model CourseRegistration {
  id        String   @id @default(uuid())
  courseId  String
  name      String
  email     String
  phone     String?
  message   String?
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
}

model Product {
  id                 String                @id @default(uuid())
  title              String
  slug               String                @unique
  description        String?
  thumbnail          String?
  price              Decimal               @default(0) @db.Decimal(12, 0)
  compareAtPrice     Decimal?              @db.Decimal(12, 0)
  type               ProductType           @default(TEMPLATE)
  membershipAccess   String                @default("ALL")
  fileUrl            String?
  previewUrl         String?
  isPublished        Boolean               @default(false)
  deploymentStatus   String                @default("RELEASED")
  tags               String[]
  // Rich content fields
  gallery            Json?                 // Array of {type: 'image'|'video', url: string, thumbnail?: string}
  detailedContent    String?               @db.Text // Markdown content
  // Countdown/Campaign fields
  campaignId         String?
  saleStartDate      DateTime?
  saleEndDate        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  field              ProductField          @default(OTHER)
  orderItems         OrderItem[]
  versions           ProductVersion[]
  subscriptions      Subscription[]
  campaign           Campaign?             @relation(fields: [campaignId], references: [id])
  // Landing page relations
  landingPages       LandingPage[]         @relation("LandingPageProduct")
  landingPagesUpsell LandingPage[]         @relation("LandingPageUpsellProduct")
  // Activation
  activationCodes    ActivationCode[]
  // Upsell relations
  upsellProducts     ProductUpsell[]       @relation("ProductToUpsellProducts")
  upsellFor          ProductUpsell[]       @relation("UpsellProductToProduct")
  upsellCourses      ProductCourseUpsell[] @relation("ProductToUpsellCourses")
  upsellFromCourse   CourseProductUpsell[] @relation("CourseUpsellProduct")
}

model ProductVersion {
  id        String   @id @default(uuid())
  version   String
  changelog String?
  fileUrl   String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  courseId  String?
  productId String?
  price     Decimal  @db.Decimal(12, 0)
  metadata  Json?
  course    Course?  @relation(fields: [courseId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([courseId])
  @@index([productId])
}

model Order {
  id              String           @id @default(uuid())
  code            String           @unique
  userId          String
  amount          Decimal          @db.Decimal(12, 0)
  status          OrderStatus      @default(PENDING)
  transactionId   String?
  paymentMethod   String?
  isGift          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  activationCodes ActivationCode[]
  marketingLead    MarketingLead?
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            OrderItem[]
  metadata         Json?
  promoCodeId      String?
  invoiceProfileId String?
  invoiceProfile   UserInvoiceProfile? @relation(fields: [invoiceProfileId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([code])
}

model PaymentTransaction {
  id              String    @id @default(uuid())
  gateway         String?
  transactionDate DateTime?
  accountNumber   String?
  subAccount      String?
  amountIn        Decimal?  @db.Decimal(15, 2)
  amountOut       Decimal?  @db.Decimal(15, 2)
  accumulated     Decimal?  @db.Decimal(15, 2)
  code            String?
  content         String?
  referenceCode   String?
  description     String?
  createdAt       DateTime  @default(now())
}

model Bundle {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  description     String?
  thumbnail       String?
  originalPrice   Int
  salePrice       Int
  discountPercent Int?
  isActive        Boolean        @default(true)
  startDate       DateTime?
  endDate         DateTime?
  badgeText       String?
  tag1            String?
  tag2            String?
  tag3            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  courses         BundleCourse[]
}

model BundleCourse {
  id       String @id @default(uuid())
  bundleId String
  courseId String
  position Int    @default(0)
  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([bundleId, courseId])
}

model Coupon {
  id            String        @id @default(uuid())
  code          String        @unique
  description   String?
  discountType  DiscountType  @default(PERCENT)
  discountValue Int
  minPurchase   Int?
  maxDiscount   Int?
  usageLimit    Int?
  usageCount    Int           @default(0)
  perUserLimit  Int           @default(1)
  isActive      Boolean       @default(true)
  startDate     DateTime?
  endDate       DateTime?
  forBirthday   Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  usages        CouponUsage[]
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String
  userId   String
  orderId  String?
  discount Int
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
}

model ActivationCode {
  id           String               @id @default(uuid())
  code         String               @unique
  courseId     String?
  productId    String?
  orderId      String?
  buyerId      String?
  redeemedById String?
  redeemedAt   DateTime?
  status       ActivationCodeStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  buyer        User?                @relation("BoughtCodes", fields: [buyerId], references: [id])
  course       Course?              @relation(fields: [courseId], references: [id])
  product      Product?             @relation(fields: [productId], references: [id])
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  redeemedBy   User?                @relation("RedeemedCodes", fields: [redeemedById], references: [id])

  @@index([code])
  @@index([status])
}

model BlogPost {
  id              String      @id @default(uuid())
  slug            String      @unique
  title           String
  excerpt         String?
  content         String
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  authorId        String?
  categoryId      String?
  isPublished     Boolean     @default(false)
  metaDescription String?
  metaKeywords    String?
  metaTitle       String?
  thumbnail       String?
  author          Instructor? @relation(fields: [authorId], references: [id])
  category        Category?   @relation(fields: [categoryId], references: [id])
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  message   String
  status    String   @default("NEW")
  updatedAt DateTime @updatedAt
}

model LandingPage {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  description     String?
  sections        String?  @db.Text
  htmlContent     String?  @db.Text
  isActive        Boolean  @default(true)
  isHomepage      Boolean  @default(false)
  // Main product - can be either course OR product
  courseId        String?
  productId       String?
  // Upsell - can be either course OR product
  upsellCourseId  String?
  upsellProductId String?
  upsellPrice     Decimal? @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  type            PageType @default(LANDING)
  // Relations
  course          Course?  @relation("LandingPageCourse", fields: [courseId], references: [id])
  product         Product? @relation("LandingPageProduct", fields: [productId], references: [id])
  upsellCourse    Course?  @relation("LandingPageUpsell", fields: [upsellCourseId], references: [id])
  upsellProduct   Product? @relation("LandingPageUpsellProduct", fields: [upsellProductId], references: [id])
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime
  productId String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  product   Product?           @relation(fields: [productId], references: [id])
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endDate])
}

enum Role {
  USER
  ADMIN
}

enum SecurityAction {
  LOGIN
  REGISTER
  PASSWORD_CHANGE
  FAILED_LOGIN
  ACCESS_DENIED
  ADMIN_ACTION
}

enum NotificationType {
  BIRTHDAY
  PROMOTION
  MAINTENANCE
  HOLIDAY
  COURSE_UPDATE
  SYSTEM
}

enum CourseDeploymentStatus {
  RELEASED
  COMING_SOON
  UPDATING
}

enum ProductDeploymentStatus {
  RELEASED
  COMING_SOON
  UPDATING
}

enum CourseTag {
  NONE
  BEST_SELLER
  HOT
  NEW
  DISCOUNT
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ActivationCodeStatus {
  ACTIVE
  USED
  EXPIRED
}

enum ProductType {
  TEMPLATE
  APP
  LICENSE
  SUBSCRIPTION
}

enum ProductField {
  ACCOUNTING
  HR
  MARKETING
  BUSINESS
  CREATIVE
  OTHER
}

enum PageType {
  SYSTEM
  LANDING
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// Campaign Model for Countdown Strategy
model Campaign {
  id        String    @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Relations
  products  Product[]
  courses   Course[]
}

// Product to Product Upsell (Self-Relation)
model ProductUpsell {
  id              String   @id @default(uuid())
  productId       String
  upsellProductId String
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  product         Product  @relation("ProductToUpsellProducts", fields: [productId], references: [id], onDelete: Cascade)
  upsellProduct   Product  @relation("UpsellProductToProduct", fields: [upsellProductId], references: [id], onDelete: Cascade)

  @@unique([productId, upsellProductId])
  @@index([productId])
}

// Course to Course Upsell (Self-Relation)
model CourseUpsell {
  id             String   @id @default(uuid())
  courseId       String
  upsellCourseId String
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  course         Course   @relation("CourseToUpsellCourses", fields: [courseId], references: [id], onDelete: Cascade)
  upsellCourse   Course   @relation("UpsellCourseToCourse", fields: [upsellCourseId], references: [id], onDelete: Cascade)

  @@unique([courseId, upsellCourseId])
  @@index([courseId])
}

// Product to Course Upsell (Cross-Entity)
model ProductCourseUpsell {
  id             String   @id @default(uuid())
  productId      String
  upsellCourseId String
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  product        Product  @relation("ProductToUpsellCourses", fields: [productId], references: [id], onDelete: Cascade)
  upsellCourse   Course   @relation("ProductUpsellCourse", fields: [upsellCourseId], references: [id], onDelete: Cascade)

  @@unique([productId, upsellCourseId])
  @@index([productId])
}

// Course to Product Upsell (Cross-Entity)
model CourseProductUpsell {
  id              String   @id @default(uuid())
  courseId        String
  upsellProductId String
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  course          Course   @relation("CourseToUpsellProducts", fields: [courseId], references: [id], onDelete: Cascade)
  upsellProduct   Product  @relation("CourseUpsellProduct", fields: [upsellProductId], references: [id], onDelete: Cascade)

  @@unique([courseId, upsellProductId])
  @@index([courseId])
}

// Calendar Events
model Event {
  id          String    @id @default(uuid())
  title       String
  description String?   @db.Text
  date        DateTime  // Event date
  time        String?   // Event time (e.g., "20:00", "19:30")
  type        EventType @default(WEBINAR)
  link        String?   // Link to course or external URL
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
  @@index([isActive])
}

enum EventType {
  WEBINAR
  WORKSHOP
  COURSE
  MEETUP
  OTHER
}

model Media {
    id        String   @id @default(uuid())
    key       String   @unique
    url       String
    name      String
    mimeType  String
    size      Int
    width     Int?
    height    Int?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    @@index([createdAt])
    @@index([mimeType])
}

model UserInvoiceProfile {
  id          String   @id @default(uuid())
  userId      String
  companyName String
  taxCode     String
  address     String
  email       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
}

model UserNote {
  id        String   @id @default(uuid())
  userId    String
  content   String   @db.Text
  adminId   String?  // The admin who wrote the note
  adminName String?  // Cached admin name
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String    // e.g., "External CRM"
  key         String    @unique
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([key])
}
